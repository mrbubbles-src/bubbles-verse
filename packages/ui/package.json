{
  "name": "@bubbles/ui",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui-runtime",
    "@hugeicons/core-free-icons": "catalog:ui-runtime",
    "@hugeicons/react": "catalog:ui-runtime",
    "@toolwind/corner-shape": "catalog:ui-runtime",
    "class-variance-authority": "catalog:ui-runtime",
    "clsx": "catalog:ui-runtime",
    "next-themes": "catalog:ui-runtime",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:forms-validation",
    "shadcn": "catalog:ui-runtime",
    "sonner": "catalog:ui-runtime",
    "tailwind-merge": "catalog:ui-runtime",
    "tw-animate-css": "catalog:ui-runtime",
    "zod": "catalog:forms-validation"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:tooling",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@turbo/gen": "catalog:tooling",
    "@types/node": "catalog:node-types",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:testing",
    "@bubbles/eslint-config": "workspace:*",
    "@bubbles/typescript-config": "workspace:*",
    "eslint": "catalog:tooling",
    "jsdom": "catalog:testing",
    "next": "catalog:",
    "tailwindcss": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./fonts": "./src/fonts.ts",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./components/bubbles-app-header": "./src/components/bubbles-sidebar/bubbles-app-header.tsx",
    "./components/bubbles-breadcrumbs": "./src/components/bubbles-sidebar/bubbles-breadcrumbs.tsx",
    "./components/bubbles-sidebar-layout": "./src/components/bubbles-sidebar/bubbles-sidebar-layout.tsx",
    "./shadcn/*": "./src/components/shadcn/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
