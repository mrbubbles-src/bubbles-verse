{
  "name": "bubbles-verse",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "next": "16.2.6",
    "@next/mdx": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint-config-next": "16.2.6",
    "babel-plugin-react-compiler": "1.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test -- --run",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:*",
    "@bubbles/typescript-config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "catalog:tooling",
    "prettier-plugin-tailwindcss": "catalog:tooling",
    "tailwindcss": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "catalogs": {
    "tooling": {
      "typescript": "5.9.3",
      "eslint": "^9.39.4",
      "tailwindcss": "^4.3.0",
      "@tailwindcss/postcss": "^4.3.0",
      "prettier": "^3.8.3",
      "prettier-plugin-tailwindcss": "^0.7.4",
      "turbo": "^2.9.14"
    },
    "testing": {
      "vitest": "^4.1.6",
      "@vitest/coverage-v8": "^4.1.6",
      "@vitest/ui": "^4.1.6",
      "jsdom": "^28.1.0",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "@vitejs/plugin-react": "^5.2.0"
    },
    "database": {
      "drizzle-orm": "^0.45.2",
      "drizzle-kit": "^0.31.10",
      "postgres": "^3.4.9"
    },
    "icons": {
      "@fortawesome/fontawesome-svg-core": "^7.2.0",
      "@fortawesome/free-brands-svg-icons": "^7.2.0",
      "@fortawesome/free-solid-svg-icons": "^7.2.0",
      "@fortawesome/react-fontawesome": "^3.3.1"
    },
    "editorjs": {
      "@editorjs/editorjs": "^2.31.6",
      "@editorjs/header": "^2.8.9"
    },
    "markdown": {
      "@mdx-js/mdx": "^3.1.1",
      "remark-gfm": "^4.0.1",
      "shiki": "^3.23.0",
      "@shikijs/transformers": "^3.23.0"
    }
  }
}
