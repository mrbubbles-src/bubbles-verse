{
  "name": "bubblophy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev --hostname bubblophy.mrbubbles.test --port 3005",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "format": "bun --bun prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"drizzle/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"drizzle.config.ts\" \"next.config.ts\" \"vitest.config.ts\"",
    "typecheck": "bun --bun next typegen && bun --bun tsc",
    "test": "bun --bun vitest",
    "test:run": "bun --bun vitest run"
  },
  "dependencies": {
    "@bubbles/supabase-access": "workspace:*",
    "@bubbles/theme": "workspace:*",
    "@bubbles/ui": "workspace:*",
    "@supabase/ssr": "catalog:supabase",
    "@supabase/supabase-js": "catalog:supabase",
    "drizzle-orm": "catalog:database",
    "next": "catalog:",
    "postgres": "catalog:database",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:forms-validation"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:*",
    "@bubbles/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@tailwindcss/postcss": "catalog:tooling",
    "@types/node": "catalog:node-types",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:",
    "drizzle-kit": "catalog:database",
    "eslint": "catalog:tooling",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:testing",
    "tailwindcss": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
