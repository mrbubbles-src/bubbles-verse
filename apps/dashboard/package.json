{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev --hostname dashboard.mrbubbles.test --port 3004",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "typecheck": "bun --bun next typegen && bun --bun tsc",
    "test": "bun --bun vitest",
    "test:run": "bun --bun vitest run"
  },
  "dependencies": {
    "@bubbles/footer": "workspace:*",
    "@bubbles/markdown-editor": "workspace:*",
    "@bubbles/markdown-renderer": "workspace:*",
    "@bubbles/theme": "workspace:*",
    "@bubbles/ui": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.8",
    "drizzle-orm": "^0.45.0",
    "next": "catalog:",
    "postgres": "^3.4.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:*",
    "@bubbles/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@tailwindcss/postcss": "catalog:tooling",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:",
    "drizzle-kit": "^0.31.8",
    "eslint": "catalog:tooling",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:testing",
    "tailwindcss": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
