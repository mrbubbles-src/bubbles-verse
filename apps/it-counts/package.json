{
  "name": "it-counts",
  "version": "1.0.2",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev --hostname itcounts.mrbubbles.test --port 3003",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "typecheck": "bun --bun tsc",
    "test": "bun --bun vitest",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest --coverage",
    "test:run": "bun --bun vitest run"
  },
  "dependencies": {
    "@bubbles/footer": "workspace:*",
    "@bubbles/theme": "workspace:*",
    "@bubbles/ui": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:*",
    "@bubbles/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@tailwindcss/postcss": "catalog:tooling",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:tooling",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:testing",
    "tailwindcss": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
