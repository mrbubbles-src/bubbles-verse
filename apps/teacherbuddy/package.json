{
  "name": "teacherbuddy",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev --hostname teacherbuddy.mrbubbles.test --port 3002",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "typecheck": "bun --bun tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@bubbles/footer": "workspace:*",
    "@bubbles/theme": "workspace:*",
    "@bubbles/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:^",
    "@bubbles/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:tooling",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/node": "^25.2.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:tooling",
    "jsdom": "catalog:testing",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
