{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev --hostname portfolio.mrbubbles.test --port 3000",
    "build": "bun --bun next build",
    "postbuild": "bun --bun next-sitemap",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@bubbles/ui": "workspace:*",
    "@formatjs/intl-localematcher": "catalog:app-runtime",
    "@fortawesome/fontawesome-svg-core": "catalog:icons",
    "@fortawesome/free-brands-svg-icons": "catalog:icons",
    "@fortawesome/free-solid-svg-icons": "catalog:icons",
    "@fortawesome/react-fontawesome": "catalog:icons",
    "@wojtekmaj/react-hooks": "catalog:app-runtime",
    "negotiator": "^1.0.0",
    "next": "catalog:",
    "next-sitemap": "^4.2.3",
    "next-themes": "catalog:ui-runtime",
    "nodemailer": "catalog:email",
    "pdfjs-dist": "catalog:pdf",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:forms-validation",
    "react-pdf": "catalog:pdf",
    "react-turnstile": "catalog:app-runtime",
    "resend": "catalog:email",
    "zod": "catalog:forms-validation"
  },
  "devDependencies": {
    "@bubbles/eslint-config": "workspace:^",
    "@bubbles/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:tooling",
    "@types/negotiator": "^0.6.4",
    "@types/node": "catalog:node-types",
    "@types/nodemailer": "catalog:email",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:tooling",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": "catalog:tooling"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
